PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/mithera?retryWrites=true&w=majority

# 로그인 토큰 서명용 비밀 문자열. 아래 명령으로 만들 수 있어요.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# 이 이메일로 가입/로그인한 계정은 자동으로 admin(user_type) 이 돼요.
ADMIN_EMAIL=you@example.com

# 구글 로그인 (Google Cloud Console > OAuth 클라이언트)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# 네이버 로그인 (네이버 개발자센터 > 애플리케이션 > 네이버 로그인)
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret
NAVER_REDIRECT_URI=http://localhost:5000/api/auth/naver/callback

# 카카오 로그인 (Kakao Developers > 내 애플리케이션). CLIENT_ID 는 REST API 키
KAKAO_CLIENT_ID=your-kakao-rest-api-key
KAKAO_CLIENT_SECRET=your-kakao-client-secret
KAKAO_REDIRECT_URI=http://localhost:5000/api/auth/kakao/callback

# 로그인 후 돌아갈 클라이언트 주소
CLIENT_URL=http://localhost:5173
